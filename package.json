{
  "name": "observability",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "drizzle-kit generate && drizzle-kit migrate && tsx watch src/server.ts",
    "build": "vite build && esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --external:pg-native --external:lightningcss --external:fsevents --external:vite",
